{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edrm.space/schemas/desktop/trade.schema.json",
  "title": "TradeTab",
  "description": "The Trade tab (ADR 0047): trade_options() returns TradeOptions; galaxy_prices(PricesRequest) returns PricesAnswer; station_market(StationMarketRequest) returns StationMarketAnswer; plan_route(RouteRequest) and follow_route(RouteRequest with its job) return RouteAnswer (ADR 0057); where to buy and sell, and the cargo's worth, are find_markets and estimate_cargo (markets.schema.json). Names in the player's language.",
  "type": "object",
  "properties": {
    "TradeOptions": {
      "$ref": "#/$defs/TradeOptions"
    },
    "PricesRequest": {
      "$ref": "#/$defs/PricesRequest"
    },
    "PricesAnswer": {
      "$ref": "#/$defs/PricesAnswer"
    },
    "StationMarketRequest": {
      "$ref": "#/$defs/StationMarketRequest"
    },
    "StationMarketAnswer": {
      "$ref": "#/$defs/StationMarketAnswer"
    },
    "RouteRequest": {
      "$ref": "#/$defs/RouteRequest"
    },
    "RouteAnswer": {
      "$ref": "#/$defs/RouteAnswer"
    }
  },
  "$defs": {
    "TradeOptions": {
      "title": "TradeOptions",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories",
        "system",
        "station",
        "pad",
        "cargoCapacity",
        "jumpRange",
        "credits",
        "sources"
      ],
      "properties": {
        "categories": {
          "type": "array",
          "description": "The market's categories in the game's order, each with its commodities by name.",
          "items": {
            "$ref": "#/$defs/CommodityCategory"
          }
        },
        "system": {
          "type": [
            "string",
            "null"
          ],
          "description": "The current system, once the journal names it."
        },
        "station": {
          "type": [
            "string",
            "null"
          ],
          "description": "The station the commander is docked at, if any."
        },
        "pad": {
          "enum": [
            "small",
            "medium",
            "large",
            null
          ],
          "description": "The pad the ship needs; null until the journal names the ship."
        },
        "cargoCapacity": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The ship's cargo capacity in tonnes, from its loadout."
        },
        "jumpRange": {
          "type": [
            "number",
            "null"
          ],
          "description": "The ship's jump range unladen, in light years, from its loadout."
        },
        "credits": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The commander's credits at the game's load: the journal gives no running balance."
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ardent",
            "spansh"
          ],
          "properties": {
            "ardent": {
              "type": "boolean",
              "description": "Whether the player lets the application ask Ardent Insight."
            },
            "spansh": {
              "type": "boolean",
              "description": "Whether the player lets the application ask Spansh."
            }
          }
        }
      }
    },
    "CommodityCategory": {
      "title": "CommodityCategory",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "name",
        "commodities"
      ],
      "properties": {
        "category": {
          "type": "string",
          "description": "chemicals, consumer_items, foods, industrial_materials…"
        },
        "name": {
          "type": "string"
        },
        "commodities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commodity",
              "name",
              "rare"
            ],
            "properties": {
              "commodity": {
                "type": "string",
                "description": "The key the sources and the journal use (gold, lowtemperaturediamond)."
              },
              "name": {
                "type": "string"
              },
              "rare": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "PricesRequest": {
      "title": "PricesRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commodity"
      ],
      "properties": {
        "commodity": {
          "type": "string",
          "description": "The commodity's key (gold, lowtemperaturediamond)."
        },
        "refresh": {
          "type": "boolean"
        }
      }
    },
    "PricesAnswer": {
      "title": "PricesAnswer",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source",
        "readAt",
        "unavailable",
        "buy",
        "sell",
        "computedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "found",
            "off",
            "busy",
            "down",
            "invalid"
          ],
          "description": "found: the source answered (now or from the cache); off, busy, down: it gave nothing (ADR 0039); invalid: the request was refused."
        },
        "source": {
          "enum": [
            "spansh",
            "ardent",
            null
          ],
          "description": "The source that answered, or would have."
        },
        "readAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When the source was read (UTC): now, or when the cached answer was."
        },
        "unavailable": {
          "enum": [
            "off",
            "busy",
            "down",
            null
          ],
          "description": "Set when the source failed and the cache answered."
        },
        "buy": {
          "anyOf": [
            {
              "$ref": "#/$defs/PriceRange"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the markets ask; null when none sells the commodity, or the source does not know it."
        },
        "sell": {
          "anyOf": [
            {
              "$ref": "#/$defs/PriceRange"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the markets pay; null when none buys the commodity, or the source does not know it."
        },
        "computedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When the source computed the prices (UTC); null without prices."
        }
      }
    },
    "PriceRange": {
      "title": "PriceRange",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lowest",
        "average",
        "highest"
      ],
      "description": "Credits per tonne across the markets the source knows.",
      "properties": {
        "lowest": {
          "type": "integer"
        },
        "average": {
          "type": "integer"
        },
        "highest": {
          "type": "integer"
        }
      }
    },
    "StationMarketRequest": {
      "title": "StationMarketRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compare"
      ],
      "properties": {
        "compare": {
          "type": "boolean",
          "description": "Compare each price with the galaxy's average: asks Ardent Insight (one answer for every commodity, kept a day)."
        },
        "refresh": {
          "type": "boolean"
        }
      }
    },
    "StationMarketAnswer": {
      "title": "StationMarketAnswer",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "comparison"
      ],
      "properties": {
        "market": {
          "description": "null until the commander, docked, opens the station's commodity market; and again once they leave.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/StationMarket"
            }
          ]
        },
        "comparison": {
          "description": "null when not asked: no comparison.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "source",
                "readAt",
                "unavailable"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "found",
                    "off",
                    "busy",
                    "down",
                    "invalid"
                  ],
                  "description": "found: the source answered (now or from the cache); off, busy, down: it gave nothing (ADR 0039); invalid: the request was refused."
                },
                "source": {
                  "enum": [
                    "spansh",
                    "ardent",
                    null
                  ],
                  "description": "The source that answered, or would have."
                },
                "readAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time",
                  "description": "When the source was read (UTC): now, or when the cached answer was."
                },
                "unavailable": {
                  "enum": [
                    "off",
                    "busy",
                    "down",
                    null
                  ],
                  "description": "Set when the source failed and the cache answered."
                }
              }
            }
          ]
        }
      }
    },
    "StationMarket": {
      "title": "StationMarket",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "station",
        "system",
        "carrier",
        "readAt",
        "categories"
      ],
      "properties": {
        "station": {
          "type": [
            "string",
            "null"
          ]
        },
        "system": {
          "type": [
            "string",
            "null"
          ]
        },
        "carrier": {
          "type": "boolean"
        },
        "readAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the player opened the market (UTC)."
        },
        "categories": {
          "type": "array",
          "description": "The categories in the game's order, each with the commodities the station sells or buys, by name.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "name",
              "commodities"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "commodities": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/StationMarketLine"
                }
              }
            }
          }
        }
      }
    },
    "StationMarketLine": {
      "title": "StationMarketLine",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commodity",
        "name",
        "rare",
        "buy",
        "sell"
      ],
      "properties": {
        "commodity": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rare": {
          "type": "boolean"
        },
        "buy": {
          "description": "What the station sells: null without a stock.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "price",
                "stock",
                "gap"
              ],
              "properties": {
                "price": {
                  "type": "integer",
                  "description": "Credits per tonne the station asks."
                },
                "stock": {
                  "type": "integer"
                },
                "gap": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "The price's gap with the galaxy's average, as a fraction (0.18: 18 % above); null until compared, or without an average."
                }
              }
            }
          ]
        },
        "sell": {
          "description": "What the station buys: null without a demand.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "price",
                "demand",
                "gap"
              ],
              "properties": {
                "price": {
                  "type": "integer",
                  "description": "Credits per tonne the station pays."
                },
                "demand": {
                  "type": "integer"
                },
                "gap": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "The price's gap with the galaxy's average, as a fraction (0.18: 18 % above); null until compared, or without an average."
                }
              }
            }
          ]
        }
      }
    },
    "RouteRequest": {
      "title": "RouteRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "station",
        "cargoCapacity",
        "credits",
        "maxHops",
        "maxHopDistance",
        "pad",
        "maxPriceDays",
        "planetary",
        "carriers"
      ],
      "properties": {
        "system": {
          "type": "string"
        },
        "station": {
          "type": "string",
          "description": "Where the route starts."
        },
        "cargoCapacity": {
          "type": "integer",
          "minimum": 1
        },
        "credits": {
          "type": "integer",
          "minimum": 0,
          "description": "What the player may spend on the first purchase: sent to Spansh."
        },
        "maxHops": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "maxHopDistance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Light years per hop."
        },
        "pad": {
          "enum": [
            "small",
            "medium",
            "large",
            null
          ]
        },
        "maxPriceDays": {
          "type": "integer",
          "minimum": 1,
          "description": "The oldest prices accepted, in days."
        },
        "planetary": {
          "type": "boolean"
        },
        "carriers": {
          "type": "boolean"
        },
        "refresh": {
          "type": "boolean"
        },
        "job": {
          "type": "string",
          "description": "follow_route only: the job plan_route answered."
        }
      }
    },
    "RouteStation": {
      "title": "RouteStation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "station",
        "system",
        "arrival",
        "pricesUpdated"
      ],
      "properties": {
        "station": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "arrival": {
          "type": [
            "number",
            "null"
          ],
          "description": "Light seconds from the arrival point."
        },
        "pricesUpdated": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When Spansh last saw the station's prices (UTC)."
        }
      }
    },
    "RouteAnswer": {
      "title": "RouteAnswer",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source",
        "readAt",
        "unavailable",
        "job",
        "hops",
        "profit"
      ],
      "properties": {
        "status": {
          "enum": [
            "found",
            "pending",
            "off",
            "busy",
            "down",
            "invalid"
          ],
          "description": "found: the route (now or from the cache); pending: Spansh is computing it, ask follow_route with the job; off, busy, down: Spansh gave nothing (ADR 0039); invalid: the form was refused."
        },
        "source": {
          "enum": [
            "spansh",
            "ardent",
            null
          ],
          "description": "The source that answered, or would have."
        },
        "readAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When the source was read (UTC): now, or when the cached answer was."
        },
        "unavailable": {
          "enum": [
            "off",
            "busy",
            "down",
            null
          ],
          "description": "Set when the source failed and the cache answered."
        },
        "job": {
          "type": [
            "string",
            "null"
          ],
          "description": "While pending: Spansh's job."
        },
        "hops": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "destination",
              "distance",
              "profit",
              "commodities"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/RouteStation"
              },
              "destination": {
                "$ref": "#/$defs/RouteStation"
              },
              "distance": {
                "type": "number",
                "description": "Light years."
              },
              "profit": {
                "type": "integer"
              },
              "commodities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "tons",
                    "buyPrice",
                    "sellPrice",
                    "profit",
                    "totalProfit"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "tons": {
                      "type": "integer"
                    },
                    "buyPrice": {
                      "type": "integer",
                      "description": "Credits per tonne at the hop's start."
                    },
                    "sellPrice": {
                      "type": "integer",
                      "description": "Credits per tonne at the hop's end."
                    },
                    "profit": {
                      "type": "integer",
                      "description": "Credits per tonne."
                    },
                    "totalProfit": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "profit": {
          "type": "integer",
          "description": "The route's hops together."
        }
      }
    }
  }
}
