{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edrm.space/schemas/desktop/goal_catalogue.schema.json",
  "title": "GoalCatalogue",
  "description": "What the goal form and the blueprints tab offer (ADR 0017, ADR 0027): returned once by the core's catalogue() call. Names in the player's language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "modules",
    "onFootItems",
    "onFootModifications"
  ],
  "properties": {
    "date": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "blueprints",
          "effects"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "blueprints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "title",
                "grades",
                "recipes"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "grades": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                },
                "recipes": {
                  "description": "One per grade, in grade order: what a roll takes, and the engineers offering that grade (catalogue ids).",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "grade",
                      "ingredients",
                      "engineers"
                    ],
                    "properties": {
                      "grade": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "ingredients": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/ingredient"
                        }
                      },
                      "engineers": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "title",
                "ingredients"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "ingredients": {
                  "description": "What one application takes.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ingredient"
                  }
                }
              }
            }
          }
        }
      }
    },
    "onFootItems": {
      "description": "Suits then weapons, with their known class upgrades (ADR 0027, ADR 0030).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "kind",
          "name",
          "upgrades"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "suit",
              "weapon"
            ]
          },
          "name": {
            "type": "string"
          },
          "upgrades": {
            "description": "The known steps, by the class they rise to; an unknown one is absent.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "toClass",
                "credits",
                "confidence",
                "ingredients"
              ],
              "properties": {
                "toClass": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 5
                },
                "credits": {
                  "type": "integer",
                  "minimum": 1
                },
                "confidence": {
                  "enum": [
                    "game",
                    "deduced",
                    "web"
                  ],
                  "description": "Seen in game, deduced from a rule read in game, or read from public sources (ADR 0030)."
                },
                "ingredients": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ingredient"
                  }
                }
              }
            }
          }
        }
      }
    },
    "onFootModifications": {
      "description": "Modifications of suits then weapons, with the on-foot engineers seen offering them and their recipe on each item type read (ADR 0027, ADR 0030).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "kind",
          "name",
          "engineers",
          "recipes"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "description": "As the journal writes it in SuitMods or WeaponMods."
          },
          "kind": {
            "enum": [
              "suit",
              "weapon"
            ]
          },
          "name": {
            "type": "string"
          },
          "engineers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recipes": {
            "description": "An item type without a recipe has its recipe unknown.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "items",
                "credits",
                "confidence",
                "ingredients"
              ],
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "description": "Journal symbols of the suit or weapon types it was read on, and holds for."
                },
                "credits": {
                  "type": "integer",
                  "minimum": 1
                },
                "confidence": {
                  "enum": [
                    "game",
                    "deduced",
                    "web"
                  ],
                  "description": "Seen in game, deduced from a rule read in game, or read from public sources (ADR 0030)."
                },
                "ingredients": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ingredient"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "name",
        "count"
      ],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
