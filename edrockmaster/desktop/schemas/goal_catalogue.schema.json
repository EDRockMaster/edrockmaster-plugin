{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edrm.space/schemas/desktop/goal_catalogue.schema.json",
  "title": "GoalCatalogue",
  "description": "What the goal form and the blueprints tab offer (ADR 0017): returned once by the core's catalogue() call. Names in the player's language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "modules"
  ],
  "properties": {
    "date": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "blueprints",
          "effects"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "blueprints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "title",
                "grades",
                "recipes"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "grades": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                },
                "recipes": {
                  "description": "One per grade, in grade order: what a roll takes, and the engineers offering that grade (catalogue ids).",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "grade",
                      "ingredients",
                      "engineers"
                    ],
                    "properties": {
                      "grade": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "ingredients": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/ingredient"
                        }
                      },
                      "engineers": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "title",
                "ingredients"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "ingredients": {
                  "description": "What one application takes.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ingredient"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "name",
        "count"
      ],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
