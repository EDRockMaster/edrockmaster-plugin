{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edrm.space/schemas/desktop/live_view.schema.json",
  "title": "LiveView",
  "description": "What the core shows of the activities, pushed to the interface after each change (ADR 0020, ADR 0021). Texts of the blocks are already in the player's language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "language",
    "current",
    "activities",
    "notice",
    "journal",
    "situation",
    "engineering"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "language": {
      "enum": [
        "en",
        "fr"
      ],
      "description": "The language of the texts, and of the interface's own catalogue."
    },
    "current": {
      "$ref": "#/$defs/activity",
      "description": "The last activity that progressed."
    },
    "activities": {
      "type": "array",
      "description": "The activities the player shows, in display order.",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "notice": {
      "description": "Local data reset or unavailable (ADR 0018), until dismissed.",
      "enum": [
        "reset",
        "unavailable",
        null
      ]
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "folder",
        "file"
      ],
      "properties": {
        "folder": {
          "type": [
            "string",
            "null"
          ],
          "description": "The journal folder; null when none was found."
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "description": "The journal file being read."
        }
      }
    },
    "situation": {
      "$ref": "#/$defs/situation"
    },
    "engineering": {
      "$ref": "#/$defs/engineering"
    }
  },
  "$defs": {
    "activity": {
      "enum": [
        "mining",
        "combat",
        "trade",
        "engineering"
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity",
        "status",
        "lines",
        "alert",
        "canReset"
      ],
      "properties": {
        "activity": {
          "$ref": "#/$defs/activity"
        },
        "status": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "alert": {
          "type": [
            "string",
            "null"
          ]
        },
        "canReset": {
          "type": "boolean"
        }
      }
    },
    "situation": {
      "type": "object",
      "additionalProperties": false,
      "description": "The commander's situation (ADR 0023): unknown parts are null. Kept nowhere.",
      "required": [
        "commander",
        "ship",
        "onFoot",
        "system",
        "station",
        "mode",
        "group",
        "wing",
        "gameRunning"
      ],
      "properties": {
        "commander": {
          "type": [
            "string",
            "null"
          ]
        },
        "ship": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "name",
                "ident"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "description": "The ship's type, in the game's language when the journal gives it, else its symbol."
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ident": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "onFoot": {
          "type": "boolean"
        },
        "system": {
          "type": [
            "string",
            "null"
          ]
        },
        "station": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "open",
            "solo",
            "group",
            null
          ]
        },
        "group": {
          "type": [
            "string",
            "null"
          ],
          "description": "The private group's name."
        },
        "wing": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The other members of the wing."
        },
        "gameRunning": {
          "type": "boolean"
        }
      }
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "name",
        "count",
        "held"
      ],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "held": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "engineering": {
      "type": "object",
      "additionalProperties": false,
      "description": "Inventory, ship engineers, goals and shopping list (ADR 0017). Names in the player's language.",
      "required": [
        "inventoryKnown",
        "materials",
        "engineers",
        "goals",
        "shoppingList",
        "catalogueDate"
      ],
      "properties": {
        "inventoryKnown": {
          "type": "boolean",
          "description": "False until the game states the inventory."
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "name",
              "category",
              "grade",
              "count",
              "cap"
            ],
            "properties": {
              "symbol": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "raw",
                  "manufactured",
                  "encoded",
                  null
                ]
              },
              "grade": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "cap": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "engineers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "status",
              "rank"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "known",
                  "invited",
                  "acquainted",
                  "unlocked",
                  "barred",
                  null
                ]
              },
              "rank": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "title",
              "module",
              "grade",
              "count",
              "known",
              "ready",
              "missing",
              "engineers"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "blueprint",
                  "effect"
                ]
              },
              "title": {
                "type": "string"
              },
              "module": {
                "type": "string"
              },
              "grade": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "known": {
                "type": "boolean"
              },
              "ready": {
                "type": "boolean"
              },
              "missing": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/ingredient"
                    }
                  }
                ],
                "description": "What the inventory lacks for the goal; null while the inventory is unknown."
              },
              "engineers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Unlocked engineers offering it."
              }
            }
          }
        },
        "shoppingList": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        },
        "catalogueDate": {
          "type": "string"
        }
      }
    }
  }
}
