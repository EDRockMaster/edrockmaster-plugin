{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edrm.space/schemas/desktop/live_view.schema.json",
  "title": "LiveView",
  "description": "What the core shows of the activities, pushed to the interface after each change (ADR 0020, ADR 0021). Texts of the blocks are already in the player's language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "application",
    "language",
    "current",
    "activities",
    "notice",
    "journal",
    "situation",
    "engineering"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "description": "The full version of the running build (ADR 0016): 0.4.0, 0.4.0-rc.1, 0.4.0-dev+5d45dbc."
        }
      }
    },
    "language": {
      "enum": [
        "en",
        "fr"
      ],
      "description": "The language of the texts, and of the interface's own catalogue."
    },
    "current": {
      "$ref": "#/$defs/activity",
      "description": "The last activity that progressed."
    },
    "activities": {
      "type": "array",
      "description": "The activities the player shows, in display order.",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "notice": {
      "description": "Local data reset or unavailable (ADR 0018), until dismissed.",
      "enum": [
        "reset",
        "unavailable",
        null
      ]
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "folder",
        "file"
      ],
      "properties": {
        "folder": {
          "type": [
            "string",
            "null"
          ],
          "description": "The journal folder; null when none was found."
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "description": "The journal file being read."
        }
      }
    },
    "situation": {
      "$ref": "#/$defs/situation"
    },
    "engineering": {
      "$ref": "#/$defs/engineering"
    }
  },
  "$defs": {
    "activity": {
      "enum": [
        "mining",
        "combat",
        "trade",
        "engineering"
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity",
        "status",
        "lines",
        "alert",
        "canReset"
      ],
      "properties": {
        "activity": {
          "$ref": "#/$defs/activity"
        },
        "status": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "alert": {
          "type": [
            "string",
            "null"
          ]
        },
        "canReset": {
          "type": "boolean"
        }
      }
    },
    "situation": {
      "type": "object",
      "additionalProperties": false,
      "description": "The commander's situation (ADR 0023): unknown parts are null. Kept nowhere.",
      "required": [
        "commander",
        "ship",
        "onFoot",
        "system",
        "station",
        "mode",
        "group",
        "wing",
        "gameRunning"
      ],
      "properties": {
        "commander": {
          "type": [
            "string",
            "null"
          ]
        },
        "ship": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "name",
                "ident"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "description": "The ship's type, in the game's language when the journal gives it, else its symbol."
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ident": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "onFoot": {
          "type": "boolean"
        },
        "system": {
          "type": [
            "string",
            "null"
          ]
        },
        "station": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "open",
            "solo",
            "group",
            null
          ]
        },
        "group": {
          "type": [
            "string",
            "null"
          ],
          "description": "The private group's name."
        },
        "wing": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The other members of the wing."
        },
        "gameRunning": {
          "type": "boolean"
        }
      }
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "name",
        "count",
        "held"
      ],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "held": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "engineering": {
      "type": "object",
      "additionalProperties": false,
      "description": "Inventory, ship engineers, goals and shopping list (ADR 0017). Names in the player's language.",
      "required": [
        "inventoryKnown",
        "materials",
        "engineers",
        "goals",
        "shoppingList",
        "catalogueDate",
        "onFoot"
      ],
      "properties": {
        "inventoryKnown": {
          "type": "boolean",
          "description": "False until the game states the inventory."
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "name",
              "category",
              "grade",
              "count",
              "cap"
            ],
            "properties": {
              "symbol": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "raw",
                  "manufactured",
                  "encoded",
                  null
                ]
              },
              "grade": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "cap": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "engineers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "status",
              "rank",
              "sheet"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "known",
                  "invited",
                  "acquainted",
                  "unlocked",
                  "barred",
                  null
                ]
              },
              "rank": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "sheet": {
                "$ref": "#/$defs/engineerSheet"
              }
            }
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "title",
              "module",
              "grade",
              "count",
              "known",
              "ready",
              "missing",
              "engineers"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "blueprint",
                  "effect"
                ]
              },
              "title": {
                "type": "string"
              },
              "module": {
                "type": "string"
              },
              "grade": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "known": {
                "type": "boolean"
              },
              "ready": {
                "type": "boolean"
              },
              "missing": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/ingredient"
                    }
                  }
                ],
                "description": "What the inventory lacks for the goal; null while the inventory is unknown."
              },
              "engineers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Unlocked engineers offering it."
              }
            }
          }
        },
        "shoppingList": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        },
        "catalogueDate": {
          "type": "string"
        },
        "onFoot": {
          "$ref": "#/$defs/onFoot"
        }
      }
    },
    "onFoot": {
      "type": "object",
      "additionalProperties": false,
      "description": "On foot (ADR 0027, ADR 0029, ADR 0030): materials held, on-foot engineers, suits and weapons seen, moves to or from the player's fleet carrier, class upgrade goals with their shopping list and credits. Names in the player's language.",
      "required": [
        "known",
        "materials",
        "engineers",
        "equipment",
        "carrierMoves",
        "goals",
        "modifications",
        "shoppingList",
        "credits"
      ],
      "properties": {
        "known": {
          "type": "boolean",
          "description": "False until the game states the ship locker."
        },
        "materials": {
          "type": "array",
          "description": "Materials held, by kind then name.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "name",
              "kind",
              "locker",
              "backpack",
              "mission"
            ],
            "properties": {
              "symbol": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "item",
                  "component",
                  "data",
                  "consumable"
                ]
              },
              "locker": {
                "type": "integer",
                "minimum": 0,
                "description": "The player's own, in the ship locker."
              },
              "backpack": {
                "type": "integer",
                "minimum": 0,
                "description": "The player's own, in the backpack."
              },
              "mission": {
                "type": "integer",
                "minimum": 0,
                "description": "Held for missions, in either place."
              }
            }
          }
        },
        "engineers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "status",
              "sheet"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "known",
                  "invited",
                  "acquainted",
                  "unlocked",
                  "barred",
                  null
                ]
              },
              "sheet": {
                "$ref": "#/$defs/engineerSheet"
              }
            }
          }
        },
        "equipment": {
          "type": "array",
          "description": "Suits first, then weapons.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "symbol",
              "name",
              "class",
              "mods"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "suit",
                  "weapon"
                ]
              },
              "symbol": {
                "type": "string",
                "description": "Journal symbol of its type, without class: what a class upgrade goal names."
              },
              "name": {
                "type": "string"
              },
              "class": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "1 to 5; null for the flight suit."
              },
              "mods": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Journal symbols of its modifications (SuitMods, WeaponMods)."
              }
            }
          }
        },
        "carrierMoves": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dockedAt",
              "at",
              "materials"
            ],
            "properties": {
              "dockedAt": {
                "type": "string",
                "format": "date-time"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "description": "The last change of the locker during that docking."
              },
              "materials": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "symbol",
                    "name",
                    "count"
                  ],
                  "properties": {
                    "symbol": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "description": "Negative: moved to the carrier; positive: taken from it."
                    }
                  }
                }
              }
            }
          }
        },
        "goals": {
          "type": "array",
          "description": "Class upgrades, in the order they were added.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "item",
              "title",
              "equipmentId",
              "fromClass",
              "toClass",
              "known",
              "unknownClasses",
              "unverified",
              "credits",
              "ready",
              "missing"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "item": {
                "type": "string",
                "description": "Journal symbol of the suit or weapon type."
              },
              "title": {
                "type": "string"
              },
              "equipmentId": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "The player's own item it follows; null for any item of the type."
              },
              "fromClass": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "toClass": {
                "type": "integer",
                "minimum": 2,
                "maximum": 5
              },
              "known": {
                "type": "boolean",
                "description": "False when a step's recipe is not known."
              },
              "unknownClasses": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 5
                },
                "description": "The classes whose upgrade recipe is not known (ADR 0030)."
              },
              "unverified": {
                "type": "boolean",
                "description": "A step's recipe was not seen in game: deduced or read elsewhere (ADR 0030)."
              },
              "credits": {
                "type": "integer",
                "minimum": 0,
                "description": "Credits of the known steps: shown, not counted."
              },
              "ready": {
                "type": "boolean"
              },
              "missing": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/ingredient"
                    }
                  }
                ],
                "description": "What the on-foot materials held lack for the known steps; null while the ship locker is unknown."
              }
            }
          }
        },
        "modifications": {
          "type": "array",
          "description": "Modifications, in the order they were added.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "item",
              "title",
              "modification",
              "name",
              "equipmentId",
              "known",
              "unverified",
              "credits",
              "ready",
              "missing",
              "engineers"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "item": {
                "type": "string",
                "description": "Journal symbol of the suit or weapon type."
              },
              "title": {
                "type": "string",
                "description": "The suit or weapon type's name."
              },
              "modification": {
                "type": "string",
                "description": "Journal symbol of the modification."
              },
              "name": {
                "type": "string",
                "description": "The modification's name."
              },
              "equipmentId": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "The player's own item it follows; null for any item of the type."
              },
              "known": {
                "type": "boolean",
                "description": "False when its recipe on the item type is not known."
              },
              "unverified": {
                "type": "boolean",
                "description": "Its recipe was not seen in game: deduced or read elsewhere (ADR 0030)."
              },
              "credits": {
                "type": "integer",
                "minimum": 0,
                "description": "Credits of its recipe, if known: shown, not counted."
              },
              "ready": {
                "type": "boolean"
              },
              "missing": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/ingredient"
                    }
                  }
                ],
                "description": "What the on-foot materials held lack for it; null while the ship locker or its recipe is unknown."
              },
              "engineers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Unlocked on-foot engineers seen offering it."
              }
            }
          }
        },
        "shoppingList": {
          "type": "array",
          "description": "What the on-foot materials held lack for every class upgrade.",
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        },
        "credits": {
          "type": "integer",
          "minimum": 0,
          "description": "Credits of every class upgrade: shown, not counted."
        }
      }
    },
    "engineerSheet": {
      "description": "Where an engineer is and how to unlock them (ADR 0031); null when the catalogue has no sheet. Texts in the player's language.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system",
            "base",
            "referredBy",
            "refers",
            "invitation",
            "unlock",
            "referral",
            "unverified"
          ],
          "properties": {
            "system": {
              "type": "string",
              "description": "As the game writes it: copied to paste into the galaxy map."
            },
            "base": {
              "type": "string"
            },
            "referredBy": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The engineers who make this one known; empty, known from the start."
            },
            "refers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The engineers this one makes known."
            },
            "invitation": {
              "type": [
                "string",
                "null"
              ],
              "description": "What makes a ship engineer invite the player; null on foot."
            },
            "unlock": {
              "type": "string"
            },
            "referral": {
              "type": [
                "string",
                "null"
              ],
              "description": "An on-foot engineer's task to refer the next ones."
            },
            "unverified": {
              "type": "boolean",
              "description": "Read from public sources, not checked in game (ADR 0030)."
            }
          }
        }
      ]
    }
  }
}
