{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edrm.space/schemas/desktop/settings.schema.json",
  "title": "Settings",
  "description": "The desktop application's settings (ADR 0020): what settings() returns and save_settings() takes. Names in the player's language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alerts",
    "sound",
    "recordJournal",
    "activities",
    "language",
    "journalFolder",
    "journalFolderInUse",
    "recordingsFolder",
    "logsFolder",
    "sources",
    "updates"
  ],
  "properties": {
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thresholds",
        "minimumContent",
        "minimumRemaining",
        "cores",
        "limpets"
      ],
      "properties": {
        "thresholds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commodity",
              "name",
              "threshold"
            ],
            "properties": {
              "commodity": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "threshold": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100,
                "description": "Minimum proportion, in percent, that raises an alert; null for none."
              }
            }
          }
        },
        "minimumContent": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "minimumRemaining": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "description": "Minimum remaining reserve, in percent; null for none."
        },
        "cores": {
          "type": "boolean"
        },
        "limpets": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 999,
          "description": "Limpets on board at which to alert (ADR 0042); null for no alert."
        }
      }
    },
    "sound": {
      "type": "boolean"
    },
    "recordJournal": {
      "type": "boolean"
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "mining",
          "combat",
          "trade",
          "engineering",
          "communityGoals"
        ]
      }
    },
    "language": {
      "enum": [
        "auto",
        "en",
        "fr"
      ]
    },
    "journalFolder": {
      "type": [
        "string",
        "null"
      ],
      "description": "Set by hand; null: where the game usually writes it. Used from the next start."
    },
    "journalFolderInUse": {
      "type": [
        "string",
        "null"
      ],
      "description": "The folder read now (read only)."
    },
    "recordingsFolder": {
      "type": "string",
      "description": "Where the journal recordings go (read only); the interface can open it."
    },
    "logsFolder": {
      "type": "string",
      "description": "Where the application's log file is (read only); the interface can open it."
    },
    "sources": {
      "type": "object",
      "description": "The community sources the application may ask, on the player's action only (ADR 0039).",
      "additionalProperties": false,
      "required": [
        "spansh",
        "ardent"
      ],
      "properties": {
        "spansh": {
          "type": "boolean",
          "description": "Spansh: rings and their hotspots."
        },
        "ardent": {
          "type": "boolean",
          "description": "Ardent Insight: the markets that buy a commodity."
        }
      }
    },
    "updates": {
      "type": "object",
      "description": "Updates of the installed application (ADR 0053).",
      "additionalProperties": false,
      "required": [
        "installed",
        "check",
        "channel"
      ],
      "properties": {
        "installed": {
          "type": "boolean",
          "description": "Installed to update itself; false for a clone or a CI build (read only)."
        },
        "check": {
          "type": "boolean",
          "description": "Check for a newer version, and download it."
        },
        "channel": {
          "enum": [
            "stable",
            "beta"
          ],
          "description": "stable: productions only; beta: candidates too. The build's channel unless another is chosen."
        }
      }
    }
  }
}
